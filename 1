<!-- 视频展示 -->

<section class="video-section">

<h2>El arte de cocinar.</h2>

<p>Descubre cómo preparamos nuestros platos.</p>

<div class="video-box">
<video controls playsinline poster="images/kitchen.jpg">
<source src="media/cooking.mp4" type="video/mp4">
Tu navegador no puede reproducir este video.
</video>
</div>

</section>

<!-- 底部 -->

<footer>
<strong>So-Tasty</strong>
<p>Una experiencia para disfrutar.</p>
<p>© 2026 So-Tasty. Todos los derechos reservados.</p>
</footer>

<!-- 搜索二级界面 -->

<div class="overlay" id="search">
<button class="close-btn" onclick="closePanels()">×</button>

<div class="panel-content">

<h2>Buscar.</h2>

<input
class="search-input"
id="searchInput"
type="search"
placeholder="Buscar platos..."
oninput="searchFood()">

