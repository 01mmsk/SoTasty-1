
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff">
<title>So-Tasty | Restaurant</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  background: #fff;
  color: #1d1d1f;
}

body.locked {
  overflow: hidden;
}

/* 顶部导航 */

.navbar {
  height: 58px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(18px);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid #eeeeee;
}

.logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: #1d1d1f;
  font-size: 19px;
  font-weight: 700;
}

.logo img {
  width: 35px;
  height: 35px;
  object-fit: contain;
  display: none;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-btn {
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  display: grid;
  place-items: center;
  cursor: pointer;
  border-radius: 50%;
  color: #222;
}

.icon-btn:hover {
  background: #eeeeee;
}

.icon-btn svg {
  width: 23px;
  height: 23px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* 首页大图 */

.hero {
  min-height: 620px;
  background: linear-gradient(135deg,#28231f,#76604c);
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 70px 20px;
  position: relative;
  overflow: hidden;
}

.hero video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: .55;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero h1 {
  font-size: clamp(45px,8vw,85px);
  letter-spacing: -3px;
  margin-bottom: 18px;
}

.hero p {
  font-size: 21px;
  color: #eeeeee;
  margin-bottom: 30px;
}

.hero a {
  display: inline-block;
  color: white;
  text-decoration: none;
  border: 1px solid white;
  border-radius: 30px;
  padding: 12px 28px;
  transition: .3s;
}

.hero a:hover {
  background: white;
  color: #222;
}

/* 通用展示模块 */

.section {
  padding: 85px 7%;
  text-align: center;
}

.section h2 {
  font-size: clamp(32px,5vw,52px);
  letter-spacing: -1.5px;
  margin-bottom: 15px;
}

.section-subtitle {
  color: #777;
  font-size: 17px;
  margin-bottom: 45px;
}

.feature {
  background: #f5f5f7;
  overflow: hidden;
  border-radius: 4px;
  margin: 30px auto;
  max-width: 1300px;
  padding: 60px 20px;
}

.feature h2 {
  font-size: clamp(32px,5vw,55px);
}

.feature p {
  color: #666;
  font-size: 18px;
  margin: 15px 0 25px;
}

.feature a {
  color: #0066cc;
  text-decoration: none;
  font-size: 17px;
}

/* 菜品卡片 */

.food-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 22px;
  max-width: 1200px;
  margin: auto;
}

.food-card {
  background: #f5f5f7;
  border-radius: 15px;
  overflow: hidden;
  text-align: left;
  transition: transform .3s;
}

.food-card:hover {
  transform: translateY(-5px);
}

.food-picture {
  height: 230px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 85px;
  background: linear-gradient(135deg,#e8dfd2,#c6a88b);
}

.food-card:nth-child(2) .food-picture {
  background: linear-gradient(135deg,#d8d8ca,#aaa68c);
}

.food-card:nth-child(3) .food-picture {
  background: linear-gradient(135deg,#e9d5c6,#bd8d6d);
}

.food-info {
  padding: 23px;
}

.food-info h3 {
  font-size: 21px;
  margin-bottom: 9px;
}

.food-info p {
  color: #777;
  font-size: 14px;
  margin-bottom: 14px;
}

.price {
  font-size: 19px;
  font-weight: 700;
}

/* 视频展示 */

.video-section {
  background: #171717;
  color: white;
  padding: 85px 7%;
  text-align: center;
}

.video-section h2 {
  font-size: clamp(32px,5vw,53px);
  margin-bottom: 18px;
}

.video-section p {
  color: #aaa;
  margin-bottom: 30px;
}

.video-box {
  max-width: 1100px;
  margin: auto;
}

.video-box video {
  width: 100%;
  max-height: 600px;
  border-radius: 12px;
  object-fit: cover;
}

/* 底部 */

footer {
  background: #f5f5f7;
  padding: 45px 7%;
  color: #777;
  font-size: 13px;
  text-align: center;
  line-height: 2;
}

footer strong {
  color: #333;
}

/* 二级界面 */

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(255,255,255,.98);
  z-index: 200;
  display: none;
  overflow-y: auto;
  padding: 90px 20px 40px;
}

.overlay.active {
  display: block;
  animation: appear .25s ease;
}

@keyframes appear {
  from {opacity:0;transform:translateY(-8px);}
  to {opacity:1;transform:translateY(0);}
}

.close-btn {
  position: fixed;
  top: 15px;
  right: 7%;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 50%;
  background: #eeeeee;
  font-size: 25px;
  cursor: pointer;
  z-index: 210;
}

.panel-content {
  max-width: 750px;
  margin: auto;
}

.panel-content h2 {
  font-size: 38px;
  margin-bottom: 25px;
}

.panel-content h3 {
  margin: 25px 0 12px;
}

.search-input {
  width: 100%;
  padding: 18px;
  border: none;
  border-bottom: 2px solid #aaa;
  font-size: 20px;
  outline: none;
  background: transparent;
}

.panel-link {
  display: block;
  padding: 20px 5px;
  border-bottom: 1px solid #ddd;
  text-decoration: none;
  color: #222;
  font-size: 20px;
}

.panel-link span {
  float: right;
  color: #888;
}

.category-link {
  display: block;
  padding: 18px 5px;
  font-size: 27px;
  font-weight: 600;
  color: #222;
  text-decoration: none;
  border-bottom: 1px solid #ddd;
}

.category-link:hover,
.panel-link:hover {
  color: #0071e3;
}

/* 手机适配 */

@media(max-width:700px) {
  .navbar {
    padding: 0 15px;
  }

  .nav-actions {
    gap: 3px;
  }

  .hero {
    min-height: 550px;
  }

  .section {
    padding: 65px 18px;
  }

  .food-grid {
    grid-template-columns: 1fr;
  }

  .food-picture {
    height: 250px;
  }

  .feature {
    padding: 55px 15px;
  }
}
</style>
</head>

<body>

<!-- 顶部导航 -->

<nav class="navbar">

<a href="#" class="logo">
  <img id="restaurantLogo" src="images/logo.png" alt="Logo">
  <span id="logoText">So-Tasty</span>
</a>

<div class="nav-actions">

<button class="icon-btn" onclick="openPanel('search')" aria-label="Buscar">
<svg viewBox="0 0 24 24">
<circle cx="10.8" cy="10.8" r="7.2"/>
<path d="m16 16 5 5"/>
</svg>
</button>

<button class="icon-btn" onclick="openPanel('contact')" aria-label="Contacto">
